# .tflint.hcl — enable the AWS ruleset (invalid instance types, deprecated AMIs, ...)
# then run `tflint --init` once to download the plugin.
plugin "terraform" {
  enabled = true
  preset  = "recommended"
}

plugin "aws" {
  enabled = true
  version = "0.27.0"
  source  = "github.com/terraform-linters/tflint-ruleset-aws"
}
